generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum KycStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
}

enum DocumentType {
  AADHAAR
  PAN
  SELFIE
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BookingMode {
  INSTANT
  SCHEDULED
}

enum PricingType {
  FIXED
  QUOTATION
}

enum BookingStatus {
  SEARCHING
  ACCEPTED
  QUOTATION_PENDING
  QUOTATION_APPROVED
  EN_ROUTE
  IN_PROGRESS
  AWAITING_PAYMENT
  PAID
  CANCELLED
  EXPIRED
  REFUNDED
}

enum BroadcastResponse {
  PENDING
  ACCEPTED
  DECLINED
  LOST
  TIMEOUT
  RELEASED
}

enum QuoteStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  SUPERSEDED
}

enum PaymentStatus {
  CREATED
  CAPTURED
  FAILED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  PAID
  FAILED
}

model User {
  id           String   @id @default(cuid())
  phone        String
  role         Role
  name         String?
  email        String?
  avatarUrl    String?  @map("avatar_url")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  profile           ProviderProfile?
  addresses         Address[]
  devices           Device[]
  notifications     Notification[]
  refreshTokens     RefreshToken[]
  customerBookings  Booking[]       @relation("CustomerBookings")
  providerBookings  Booking[]       @relation("ProviderBookings")
  quotes            Quotation[]
  reviewsWritten    Review[]        @relation("ReviewsWritten")
  reviewsReceived   Review[]        @relation("ReviewsReceived")
  messages          Message[]
  payouts           Payout[]
  ledgerEntries     LedgerEntry[]

  @@unique([phone, role])
  @@map("users")
}

model OtpChallenge {
  id         String    @id @default(cuid())
  phone      String
  role       Role
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([phone, role, createdAt])
  @@map("otp_challenges")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Device {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  platform  String
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("devices")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  title     String
  body      String
  data      Json?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

model City {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  state            String
  country          String   @default("IN")
  timezone         String   @default("Asia/Kolkata")
  centerLat        Float    @map("center_lat")
  centerLng        Float    @map("center_lng")
  serviceRadiusKm  Float    @default(30) @map("service_radius_km")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  addresses        Address[]
  prices           CityServicePrice[]
  areas            ProviderServiceArea[]
  bookings         Booking[]

  @@map("cities")
}

model ServiceCategory {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  services    Service[]

  @@map("service_categories")
}

model Service {
  id                String      @id @default(cuid())
  categoryId        String      @map("category_id")
  name              String
  slug              String      @unique
  description       String
  highlights        String[]
  pricingType       PricingType @map("pricing_type")
  estimatedMinutes  Int         @map("estimated_minutes")
  sortOrder         Int         @default(0) @map("sort_order")
  isActive          Boolean     @default(true) @map("is_active")
  category          ServiceCategory @relation(fields: [categoryId], references: [id])
  prices            CityServicePrice[]
  skills            ProviderSkill[]
  bookings          Booking[]

  @@index([categoryId])
  @@map("services")
}

model CityServicePrice {
  id            String  @id @default(cuid())
  cityId        String  @map("city_id")
  serviceId     String  @map("service_id")
  pricePaise    Int?    @map("price_paise")
  commissionBps Int     @map("commission_bps")
  isActive      Boolean @default(true) @map("is_active")
  city          City    @relation(fields: [cityId], references: [id])
  service       Service @relation(fields: [serviceId], references: [id])

  @@unique([cityId, serviceId])
  @@map("city_service_prices")
}

model ProviderProfile {
  id               String    @id @default(cuid())
  userId           String    @unique @map("user_id")
  kycStatus        KycStatus @default(PENDING) @map("kyc_status")
  rejectionReason  String?   @map("rejection_reason")
  bio              String?
  experienceYears  Int       @default(0) @map("experience_years")
  ratingAvg        Float     @default(0) @map("rating_avg")
  ratingCount      Int       @default(0) @map("rating_count")
  jobsCompleted    Int       @default(0) @map("jobs_completed")
  isOnline         Boolean   @default(false) @map("is_online")
  currentLat       Float?    @map("current_lat")
  currentLng       Float?    @map("current_lng")
  lastLocationAt   DateTime? @map("last_location_at")
  location         Unsupported("geography(Point, 4326)")?
  accountName      String?   @map("account_name")
  accountNumberEnc String?   @map("account_number_enc")
  accountLast4     String?   @map("account_last4")
  ifsc             String?
  upiId            String?   @map("upi_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  user             User      @relation(fields: [userId], references: [id])
  skills           ProviderSkill[]
  areas            ProviderServiceArea[]
  availability     ProviderAvailability[]
  documents        ProviderDocument[]

  @@index([kycStatus, isOnline])
  @@map("provider_profiles")
}

model ProviderSkill {
  id        String          @id @default(cuid())
  profileId String          @map("profile_id")
  serviceId String          @map("service_id")
  profile   ProviderProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  service   Service         @relation(fields: [serviceId], references: [id])

  @@unique([profileId, serviceId])
  @@map("provider_skills")
}

model ProviderServiceArea {
  id        String          @id @default(cuid())
  profileId String          @map("profile_id")
  cityId    String          @map("city_id")
  label     String
  baseLat   Float           @map("base_lat")
  baseLng   Float           @map("base_lng")
  radiusKm  Float           @default(12) @map("radius_km")
  profile   ProviderProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  city      City            @relation(fields: [cityId], references: [id])

  @@index([cityId])
  @@map("provider_service_areas")
}

model ProviderAvailability {
  id        String          @id @default(cuid())
  profileId String          @map("profile_id")
  dayOfWeek Int             @map("day_of_week")
  startMin  Int             @map("start_min")
  endMin    Int             @map("end_min")
  isActive  Boolean         @default(true) @map("is_active")
  profile   ProviderProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, dayOfWeek])
  @@map("provider_availability")
}

model ProviderDocument {
  id         String          @id @default(cuid())
  profileId  String          @map("profile_id")
  type       DocumentType
  storageKey String          @map("storage_key")
  status     ReviewStatus    @default(PENDING)
  createdAt  DateTime        @default(now()) @map("created_at")
  profile    ProviderProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, type])
  @@map("provider_documents")
}

model Address {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  label     String
  line1     String
  landmark  String?
  areaLabel String   @map("area_label")
  lat       Float
  lng       Float
  cityId    String   @map("city_id")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city      City     @relation(fields: [cityId], references: [id])
  bookings  Booking[]

  @@index([userId])
  @@map("addresses")
}

model Booking {
  id               String        @id @default(cuid())
  customerId       String        @map("customer_id")
  providerId       String?       @map("provider_id")
  serviceId        String        @map("service_id")
  cityId           String        @map("city_id")
  addressId        String?       @map("address_id")
  serviceName      String        @map("service_name")
  pricingType      PricingType   @map("pricing_type")
  mode             BookingMode
  status           BookingStatus @default(SEARCHING)
  issueDescription String        @map("issue_description")
  scheduledAt      DateTime?     @map("scheduled_at")
  searchExpiresAt  DateTime      @map("search_expires_at")
  addressLine      String        @map("address_line")
  landmark         String?
  areaLabel        String        @map("area_label")
  lat              Float
  lng              Float
  pricePaise       Int?          @map("price_paise")
  commissionBps    Int?          @map("commission_bps")
  idempotencyKey   String?       @unique @map("idempotency_key")
  acceptedAt       DateTime?     @map("accepted_at")
  startedAt        DateTime?     @map("started_at")
  completedAt      DateTime?     @map("completed_at")
  paidAt           DateTime?     @map("paid_at")
  cancelledById    String?       @map("cancelled_by_id")
  cancelReason     String?       @map("cancel_reason")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  customer     User               @relation("CustomerBookings", fields: [customerId], references: [id])
  provider     User?              @relation("ProviderBookings", fields: [providerId], references: [id])
  service      Service            @relation(fields: [serviceId], references: [id])
  city         City               @relation(fields: [cityId], references: [id])
  address      Address?           @relation(fields: [addressId], references: [id], onDelete: SetNull)
  photos       BookingPhoto[]
  events       BookingEvent[]
  broadcasts   BookingBroadcast[]
  quotes       Quotation[]
  payments     Payment[]
  review       Review?
  conversation Conversation?
  callLogs     CallLog[]

  @@index([customerId, createdAt])
  @@index([providerId, status])
  @@index([status, searchExpiresAt])
  @@index([cityId, createdAt])
  @@map("bookings")
}

model BookingPhoto {
  id        String   @id @default(cuid())
  bookingId String   @map("booking_id")
  url       String
  createdAt DateTime @default(now()) @map("created_at")
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_photos")
}

model BookingEvent {
  id        String   @id @default(cuid())
  bookingId String   @map("booking_id")
  actorId   String?  @map("actor_id")
  type      String
  message   String
  createdAt DateTime @default(now()) @map("created_at")
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("booking_events")
}

model BookingBroadcast {
  id          String            @id @default(cuid())
  bookingId   String            @map("booking_id")
  providerId  String            @map("provider_id")
  distanceM   Int?              @map("distance_m")
  response    BroadcastResponse @default(PENDING)
  notifiedAt  DateTime          @default(now()) @map("notified_at")
  respondedAt DateTime?         @map("responded_at")
  booking     Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, providerId])
  @@index([providerId, response])
  @@map("booking_broadcasts")
}

model Quotation {
  id          String      @id @default(cuid())
  bookingId   String      @map("booking_id")
  providerId  String      @map("provider_id")
  amountPaise Int         @map("amount_paise")
  notes       String?
  lineItems   Json        @map("line_items")
  status      QuoteStatus @default(PENDING)
  validUntil  DateTime    @map("valid_until")
  createdAt   DateTime    @default(now()) @map("created_at")
  booking     Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider    User        @relation(fields: [providerId], references: [id])

  @@index([bookingId, status])
  @@map("quotations")
}

model Payment {
  id                String        @id @default(cuid())
  bookingId         String        @map("booking_id")
  amountPaise       Int           @map("amount_paise")
  commissionPaise   Int           @map("commission_paise")
  gstPaise          Int           @map("gst_paise")
  providerPaise     Int           @map("provider_paise")
  currency          String        @default("INR")
  status            PaymentStatus @default(CREATED)
  razorpayOrderId   String?       @unique @map("razorpay_order_id")
  razorpayPaymentId String?       @unique @map("razorpay_payment_id")
  checkoutTokenHash String?       @unique @map("checkout_token_hash")
  method            String?
  capturedAt        DateTime?     @map("captured_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  booking           Booking       @relation(fields: [bookingId], references: [id])
  refunds           Refund[]

  @@index([bookingId])
  @@map("payments")
}

model Refund {
  id               String   @id @default(cuid())
  paymentId        String   @map("payment_id")
  amountPaise      Int      @map("amount_paise")
  reason           String
  status           String
  razorpayRefundId String?  @map("razorpay_refund_id")
  actorId          String?  @map("actor_id")
  createdAt        DateTime @default(now()) @map("created_at")
  payment          Payment  @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@map("refunds")
}

model LedgerEntry {
  id          String   @id @default(cuid())
  providerId  String   @map("provider_id")
  bookingId   String?  @map("booking_id")
  amountPaise Int      @map("amount_paise")
  memo        String
  dedupeKey   String   @unique @map("dedupe_key")
  createdAt   DateTime @default(now()) @map("created_at")
  provider    User     @relation(fields: [providerId], references: [id])

  @@index([providerId, createdAt])
  @@map("ledger_entries")
}

model Payout {
  id          String       @id @default(cuid())
  providerId  String       @map("provider_id")
  amountPaise Int          @map("amount_paise")
  status      PayoutStatus @default(PENDING)
  reference   String?
  note        String?
  actorId     String?      @map("actor_id")
  paidAt      DateTime?    @map("paid_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  provider    User         @relation(fields: [providerId], references: [id])

  @@index([providerId])
  @@map("payouts")
}

model Review {
  id         String   @id @default(cuid())
  bookingId  String   @unique @map("booking_id")
  customerId String   @map("customer_id")
  providerId String   @map("provider_id")
  rating     Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")
  booking    Booking  @relation(fields: [bookingId], references: [id])
  customer   User     @relation("ReviewsWritten", fields: [customerId], references: [id])
  provider   User     @relation("ReviewsReceived", fields: [providerId], references: [id])

  @@index([providerId])
  @@map("reviews")
}

model Conversation {
  id        String    @id @default(cuid())
  bookingId String    @unique @map("booking_id")
  createdAt DateTime  @default(now()) @map("created_at")
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String       @map("conversation_id")
  senderId       String?      @map("sender_id")
  kind           String       @default("TEXT")
  body           String
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User?        @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@map("messages")
}

model CallLog {
  id        String   @id @default(cuid())
  bookingId String   @map("booking_id")
  callerId  String   @map("caller_id")
  createdAt DateTime @default(now()) @map("created_at")
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("call_logs")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
